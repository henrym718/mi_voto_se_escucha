# =============================================================================
# Plantilla de variables. Copiar a .env.local para desarrollo.
# .env.local NUNCA se sube al repositorio.
#
# En staging y producción NADA de esto se pone a mano en el panel de Supabase:
# lo inyecta el pipeline desde los secretos de GitHub.
# =============================================================================

# ----------------------------------------------------------------- Supabase --
# Local (los da `pnpm supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. SIN prefijo NEXT_PUBLIC_: si lleva el prefijo, Next la mete en
# el paquete del navegador y queda expuesta a cualquiera.
#
# La usa la ruta que ordena los pedidos con IA: baja la nota de voz del bucket
# privado y escribe el título en la obra, dos cosas que el vecino no puede hacer.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ Ciudad --
# Qué ciudad servir cuando el dominio no la resuelve (desarrollo local).
NEXT_PUBLIC_CIUDAD_POR_DEFECTO=el-triunfo

# Raíz absoluta del sitio. La usan los enlaces que se comparten por WhatsApp y
# las etiquetas de Open Graph; sin ella el enlace llega sin foto ni título.
NEXT_PUBLIC_SITIO_URL=http://localhost:3000

# Token personal de Supabase (empieza con sbp_). Lo usan el CLI y los
# pipelines para tocar la configuración del proyecto por la Management API.
#
# Este archivo es la PLANTILLA y se sube al repositorio: aquí van los nombres
# de las variables, nunca los valores. El token real va en .env.local, que no
# se sube, y en los secretos de GitHub.
SUPABASE_ACCESS_TOKEN=

# =============================================================================
# El ayudante que ordena los pedidos — solo servidor, sin NEXT_PUBLIC_.
#
# Corre DESPUÉS de que el vecino envía, no mientras espera: recibe la nota de
# voz y devuelve el título y la descripción que el equipo revisa en su cola.
#
# El reparto es a propósito: Whisper oye (acepta idioma y contexto, y por eso no
# se va al portugués con audio sucio de calle) y Gemini ordena. Si uno de los
# dos falla o sube de precio, se cambia solo esa mitad — y si faltan las claves,
# el pedido entra igual y el equipo lo redacta a mano desde la cola.
# =============================================================================

GEMINI_API_KEY=
# Opcional; por defecto 'gemini-3.5-flash'.
GEMINI_MODEL=

OPENAI_API_KEY=
# Opcional; por defecto 'whisper-1'.
OPENAI_TRANSCRIBE_MODEL=
