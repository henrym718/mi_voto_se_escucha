# =============================================================================
# Plantilla para producción. Copiar a .env.produccion y rellenar.
# .env.produccion NO se sube al repositorio (ya está en .gitignore).
#
# Los pipelines NO leen este archivo: ellos toman todo de los secretos de
# GitHub. Esto sirve para depurar contra producción desde la máquina.
#
# Guía completa: docs/desplegar-staging.md
# =============================================================================

# ----------------------------------------------------------------- Supabase --
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sin prefijo NEXT_PUBLIC_: con el prefijo, Next la empaqueta para el navegador.
# La usa la ruta que ordena los pedidos con IA.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Ciudad --
NEXT_PUBLIC_CIUDAD_POR_DEFECTO=el-triunfo
NEXT_PUBLIC_SITIO_URL=https://mivotoseescucha.ec

# ---------------------------------------------------------- Ayudante de IA --
# Solo servidor. Ordena la nota de voz DESPUÉS de que el vecino envía; si
# faltan, el pedido entra igual y el equipo lo redacta a mano desde la cola.
OPENAI_API_KEY=
GEMINI_API_KEY=
