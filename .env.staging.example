# =============================================================================
# Plantilla para staging. Copiar a .env.staging y rellenar.
# .env.staging NO se sube al repositorio (ya está en .gitignore).
#
# Los pipelines NO leen este archivo: ellos toman todo de los secretos de
# GitHub. Esto sirve para correr a mano el script de plantillas de WhatsApp y
# para depurar contra staging desde la máquina.
#
# Guía completa: docs/desplegar-staging.md
# =============================================================================

# ----------------------------------------------------------------- Supabase --
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sin prefijo NEXT_PUBLIC_: con el prefijo, Next la empaqueta para el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Ciudad --
NEXT_PUBLIC_CIUDAD_POR_DEFECTO=el-triunfo
NEXT_PUBLIC_SITIO_URL=https://mvse-staging.vercel.app

# -------------------------------------------------------------------- Kapso --
KAPSO_API_KEY=
# Id del NÚMERO emisor.
KAPSO_PHONE_NUMBER_ID=
# Id de la CUENTA de WhatsApp Business. Solo lo usa el script de plantillas.
KAPSO_BUSINESS_ACCOUNT_ID=
KAPSO_TEMPLATE_PREFIX=mvse_staging
KAPSO_TEMPLATE_LANG=es
APP_BASE_URL=https://mvse-staging.vercel.app

# ------------------------------------------------------------------ Hooks --
# Generar con:  echo "v1,whsec_$(openssl rand -base64 32 | tr -d '=+/' | cut -c1-40)"
SEND_SMS_HOOK_SECRET=
# Generar con:  openssl rand -hex 32
WORKER_SECRET=
